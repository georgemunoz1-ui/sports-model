{
  "schema": "ops.full_card_normalized_contract.v1",
  "artifact_type": "full_card_normalized",
  "required_authority_modes": ["PRODUCTION", "SHADOW", "DISABLED"],
  "required_statuses": ["PLAY", "LEAN", "PASS", "BLOCKED", "NO_PRICE", "NO_MODEL", "POST_START"],
