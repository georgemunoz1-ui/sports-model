{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sports_information_event.v1.json",
  "title": "Research-only sports pregame information event",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "information_event_id",
    "event_id",
    "league",
    "source",
    "forecast_timing",
    "claim",
    "extraction",
    "resolution",
    "usage_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "sports_information_event.v1"
    },
    "information_event_id": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "league": {
      "enum": [
        "MLB",
        "CFB",
        "NFL",
        "WNBA",
        "NBA",
        "NHL",
        "MLS"
      ]
    },
    "source": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "source_id",
        "source_tier",
        "source_type",
        "published_at_utc",
        "retrieved_at_utc",
        "raw_bytes_sha256"
      ],
      "properties": {
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "source_tier": {
          "type": "integer",
          "minimum": 1,
          "maximum": 6
        },
        "source_type": {
          "enum": [
            "LEAGUE_OFFICIAL",
            "TEAM_OFFICIAL",
            "BEAT_REPORTER",
            "NEWS_OUTLET",
            "AGGREGATOR",
            "FAN_SOCIAL",
            "ANONYMOUS"
          ]
        },
        "source_url": {
          "type": [
            "string",
            "null"
          ]
        },
        "post_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "source_anchor_kind": {
          "type": [
            "string",
            "null"
          ]
        },
        "published_at_utc": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "retrieved_at_utc": {
          "type": "string",
          "format": "date-time"
        },
        "raw_bytes_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      }
    },
    "forecast_timing": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "forecast_cutoff_utc",
        "game_start_utc",
        "known_before_cutoff",
        "pit_status"
      ],
      "properties": {
        "forecast_cutoff_utc": {
          "type": "string",
          "format": "date-time"
        },
        "game_start_utc": {
          "type": "string",
          "format": "date-time"
        },
        "known_before_cutoff": {
          "type": "boolean"
        },
        "pit_status": {
          "enum": [
            "PASS",
            "FAIL_POST_CUTOFF",
            "FAIL_BAD_CHRONOLOGY",
            "FAIL_TIMESTAMP_MISSING"
          ]
        }
      }
    },
    "claim": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "subject_type",
        "subject_id",
        "team_id",
        "event_type",
        "status",
        "effective_game_id",
        "certainty"
      ],
      "properties": {
        "subject_type": {
          "enum": [
            "PLAYER",
            "TEAM",
            "GAME",
            "VENUE"
          ]
        },
        "subject_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "team_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "event_type": {
          "enum": [
            "BACK_TO_BACK_LOAD",
            "BULLPEN_AVAILABLE",
            "BULLPEN_LIMITED",
            "BULLPEN_UNAVAILABLE",
            "CALLUP",
            "DEMOTION",
            "DEPTH_CHART_CHANGE",
            "FIXTURE_CONGESTION",
            "GOALIE_CONFIRMED",
            "GOALIE_LIMITED",
            "GOALIE_REST",
            "GOALKEEPER_CONFIRMED",
            "INACTIVE_CONFIRMED",
            "INJURY_DESIGNATION",
            "INTERNATIONAL_DUTY",
            "LATE_SCRATCH",
            "LINEUP_CONFIRMED",
            "LINEUP_PROJECTED",
            "LINE_COMBINATION_CHANGE",
            "MINUTES_RESTRICTION",
            "NEUTRAL_SITE_STATUS",
            "OL_INJURY_CLUSTER",
            "PLAYER_ACTIVE",
            "PLAYER_DOUBTFUL",
            "PLAYER_LIMITED",
            "PLAYER_OUT",
            "PLAYER_PROBABLE",
            "PLAYER_QUESTIONABLE",
            "PLAYER_REST",
            "PRACTICE_PARTICIPATION",
            "QB_LIMITED",
            "QB_OUT",
            "QB_STATUS",
            "REST_STATUS",
            "ROOF_STATUS",
            "ROSTER_CALLUP",
            "ROSTER_OPTION",
            "ROSTER_TRANSACTION",
            "SECONDARY_INJURY_CLUSTER",
            "SKATER_SCRATCHED",
            "SNAP_LIMIT",
            "STARTER_CONFIRMED",
            "STARTER_PITCH_LIMIT",
            "STARTER_SCRATCHED",
            "STARTING_XI_CONFIRMED",
            "SUSPENSION",
            "TRAVEL_DISRUPTION",
            "WEATHER_CHANGE",
            "WEATHER_DELAY_RISK"
          ]
        },
        "taxonomy_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "status": {
          "type": "string",
          "minLength": 1
        },
        "restriction_value": {},
        "effective_game_id": {
          "type": "string",
          "minLength": 1
        },
        "certainty": {
          "enum": [
            "CONFIRMED",
            "EXPECTED",
            "POSSIBLE",
            "UNCERTAIN",
            "CONTRADICTED"
          ]
        },
        "evidence_text": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "extraction": {
      "type": "object",
      "additionalProperties": true
    },
    "resolution": {
      "type": "object",
      "additionalProperties": true,
      "required": [
        "player_resolution_confidence",
        "team_resolution_confidence",
        "game_resolution_confidence",
        "source_verification_state",
        "cross_model_state"
      ],
      "properties": {
        "player_resolution_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "team_resolution_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "game_resolution_confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "source_verification_state": {
          "type": "string"
        },
        "cross_model_state": {
          "enum": [
            "CONSENSUS",
            "PARTIAL_AGREEMENT",
            "CONFLICTING",
            "ABSTAIN"
          ]
        }
      }
    },
    "usage_policy": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "research_feature_eligible",
        "forecast_adjustment_eligible",
        "market_input",
        "action_authority"
      ],
      "properties": {
        "research_feature_eligible": {
          "type": "boolean"
        },
        "forecast_adjustment_eligible": {
          "const": false
        },
        "market_input": {
          "const": false
        },
        "action_authority": {
          "const": "OFF"
        }
      }
    }
  }
}
