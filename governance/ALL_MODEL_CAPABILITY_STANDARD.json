{
  "schema": "sports.capability_standard.v2",
  "effective_date": "2026-10-02",
  "principle": "The incumbent is the control, not the capability ceiling. Governance protects chronology, lineage and evidence; missing capability creates a development obligation.",
  "sports": ["nfl","cfb","mlb","nba","wnba","nhl","mls"],
  "capability_states": ["CONTROL_VALID","BEST_VALIDATED","CAPABILITY_COMPLETE","RESEARCH_ONLY","SHADOW_VALIDATED","PROMOTION_ELIGIBLE","DEFAULT","QUARANTINED"],
  "evidence_levels": ["DECLARED","EXECUTED","VALIDATED"],
  "required_products": {
    "winner_probability": ["analytic","calibrated","simulated"],
    "margin": ["point_estimate","predictive_distribution","cover_probability","push_probability"],
    "total": ["point_estimate","predictive_distribution","over_probability","under_probability","push_probability"]
  },
  "required_context": ["personnel_or_starter","workload_and_role_changes","recent_team_state","rest_and_travel","venue_and_weather_when_relevant"],
  "required_lineage": ["package_hash","feature_set_hash","model_hash","calibration_hash","simulation_config_hash","frozen_forecast_hash"],
  "market_overlay": {"two_sided":true,"timestamped_pregame":true,"no_vig":true,"used_as_model_input_field_required":true,"independent_model_market_input":false},
  "validation": {
    "point_in_time_inputs": true,
    "outer_split": "chronological",
    "same_population_comparison": true,
    "winner": ["brier","log_loss","calibration_intercept","calibration_slope","ece"],
    "margin": ["mae","rmse","crps","interval_coverage"],
    "cover": ["exact_line_brier","exact_line_log_loss","calibration","settlement_universe"],
    "total": ["mae","rmse","crps","over_under_calibration"],
    "joint_distribution": ["internal_consistency","marginal_calibration","settlement_rules","replay"],
    "prospective_shadow_required_for_promotion": true
  },
  "promotion": {
    "target_specific": true,
    "cross_target_promotion_forbidden": true,
    "newer_or_more_features_is_not_evidence": true,
    "incumbent_remains_control_until_challenger_passes": true
  },
  "development_sequence": ["acquisition","identity_and_time_validation","feature_construction","historical_point_in_time_replay","chronological_oof_fitting","calibration","distributional_simulation","same_population_comparison","prospective_shadow","promotion_or_rejection"],
  "daily_card_required_fields": ["model_id","model_version","feature_set_id","feature_set_hash","input_quality_status","forecast_version","cutoff_timestamp","raw_win_probability","calibrated_win_probability","simulation_win_probability","projected_home_score","projected_away_score","projected_margin","margin_distribution_quantiles","model_cover_probability","simulation_cover_probability","push_probability","projected_total","total_distribution_quantiles","over_probability","under_probability","total_push_probability","market_two_sided_prices","market_no_vig_probability","market_capture_timestamp","market_used_as_model_input","model_market_delta","personnel_status","starter_qb_goalie_status","context_completeness","fallback_scenario_policy","forecast_artifact_hash"],
  "temporary_unsupported_rule": "NOT_SUPPORTED_BY_THIS_MODEL_VERSION is allowed only with a linked development obligation; it is never a permanent terminal state.",
  "release": {"defaults_unchanged_by_audit":true,"action_authority":false,"market_overlay":"BENCHMARK_ONLY","challengers":"RESEARCH_OR_SHADOW_ONLY"}
}
