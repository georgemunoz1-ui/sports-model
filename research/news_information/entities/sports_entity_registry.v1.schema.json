{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "sports_entity_registry.v1.schema.json",
  "title": "Canonical time-bounded sports entity registry",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "generated_at_utc",
    "teams",
    "players",
    "events"
  ],
  "properties": {
    "schema_version": {
      "const": "sports_entity_registry.v1"
    },
    "generated_at_utc": {
      "type": "string",
      "format": "date-time"
    },
    "registry_sha256": {
      "type": [
        "string",
        "null"
      ],
      "pattern": "^[0-9a-f]{64}$"
    },
    "teams": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonical_team_id",
          "league",
          "official_provider_id",
          "name",
          "aliases",
          "valid_from_utc",
          "valid_to_utc"
        ],
        "properties": {
          "canonical_team_id": {
            "type": "string",
            "minLength": 1
          },
          "league": {
            "enum": [
              "MLB",
              "NFL",
              "NBA",
              "WNBA",
              "NHL",
              "CFB",
              "MLS"
            ]
          },
          "official_provider_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "abbr": {
            "type": [
              "string",
              "null"
            ]
          },
          "aliases": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/alias"
            }
          },
          "valid_from_utc": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "valid_to_utc": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "players": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonical_player_id",
          "league",
          "official_provider_id",
          "name",
          "aliases",
          "team_assignments",
          "valid_from_utc",
          "valid_to_utc"
        ],
        "properties": {
          "canonical_player_id": {
            "type": "string",
            "minLength": 1
          },
          "league": {
            "enum": [
              "MLB",
              "NFL",
              "NBA",
              "WNBA",
              "NHL",
              "CFB",
              "MLS"
            ]
          },
          "official_provider_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "name": {
            "type": "string",
            "minLength": 1
          },
          "aliases": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/alias"
            }
          },
          "team_assignments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "team_id",
                "valid_from_utc",
                "valid_to_utc"
              ],
              "properties": {
                "team_id": {
                  "type": "string",
                  "minLength": 1
                },
                "valid_from_utc": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                },
                "valid_to_utc": {
                  "type": [
                    "string",
                    "null"
                  ],
                  "format": "date-time"
                }
              }
            }
          },
          "valid_from_utc": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          },
          "valid_to_utc": {
            "type": [
              "string",
              "null"
            ],
            "format": "date-time"
          }
        }
      }
    },
    "events": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "canonical_event_id",
          "league",
          "official_provider_event_id",
          "home_team_id",
          "away_team_id",
          "start_time_utc"
        ],
        "properties": {
          "canonical_event_id": {
            "type": "string",
            "minLength": 1
          },
          "league": {
            "enum": [
              "MLB",
              "NFL",
              "NBA",
              "WNBA",
              "NHL",
              "CFB",
              "MLS"
            ]
          },
          "official_provider_event_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "home_team_id": {
            "type": "string",
            "minLength": 1
          },
          "away_team_id": {
            "type": "string",
            "minLength": 1
          },
          "start_time_utc": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "definitions": {
    "alias": {
      "oneOf": [
        {
          "type": "string",
          "minLength": 1
        },
        {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "value",
            "valid_from_utc",
            "valid_to_utc"
          ],
          "properties": {
            "value": {
              "type": "string",
              "minLength": 1
            },
            "valid_from_utc": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            },
            "valid_to_utc": {
              "type": [
                "string",
                "null"
              ],
              "format": "date-time"
            }
          }
        }
      ]
    }
  }
}
